# --- Database (Railway Postgres provides this) ---
DATABASE_URL=postgresql://user:pass@localhost:5432/copy_updater

# --- Auth.js ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Set to your Railway public URL in production, e.g. https://copy-updater.up.railway.app
AUTH_URL=http://localhost:3000
# Comma-separated list of email domains permitted to sign in.
ALLOWED_EMAIL_DOMAINS=waveform.com,rsrf.com

# --- Encryption for stored AI provider API keys ---
# 32 bytes, base64. Generate with: openssl rand -base64 32
# Changing this makes every stored provider key unreadable.
APP_ENCRYPTION_KEY=

# --- Snapshot storage ---
# Railway: mount a volume here. Local: defaults to ./data
DATA_DIR=./data
